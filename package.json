{
  "name": "tome-rpg-manager",
  "version": "15.0.0",
  "description": "Sistema VTT Offline/LAN para Campanhas de RPG",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "vite build && node scripts/start-cli.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "seed:5e": "node scripts/seedSystemDND5e.js",
    "sanitize": "node scripts/sanitize_state_files.js --prune-empty"
  },
  "dependencies": {
    "@preact/signals": "^2.11.0",
    "@prisma/client": "^5.22.0",
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "htm": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "konva": "^10.3.0",
    "multer": "^2.2.0",
    "preact": "^10.29.8",
    "socket.io": "^4.7.5",
    "ws": "^8.21.1",
    "y-websocket": "^1.5.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "autoprefixer": "^10.4.19",
    "babel-plugin-htm": "^3.0.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/packages/"
    ]
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

// --- Entidades de Domínio ---

model Master {
  internalId String   @id
  masterId   String   @unique
  name       String
  phone      String   @unique
  tables     String   @default("[]") // JSON string of table IDs they own
  createdAt  DateTime @default(now())
}

model TableSession {
  tableId   String   @id
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PlayerSession {
  sessionToken String  @id
  tableId      String
  characterId  String?
  connected    Boolean @default(false)
  nome         String?
  avatar       String?
  classe       String?
  updatedAt    DateTime @default(now()) @updatedAt
}

model Character {
  id        String  @id @default(uuid())
  name      String
  ownerId   String?
  sheetData String
}

model ChatMessage {
  id        String   @id @default(uuid())
  tableId   String
  sender    String
  message   String
  timestamp DateTime @default(now())
}

model Encounter {
  id        String @id @default(uuid())
  tableId   String
  state     String
}

model StateDocument {
  id        String   @id
  content   String
  updatedAt DateTime @default(now()) @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  PLAYER
  VIEWER
}

model User {
  id          String               @id @default(uuid())
  name        String
  email       String               @unique
  memberships CampaignMembership[]
}

model CampaignMembership {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  role       Role     @default(PLAYER)
}

model RuleSystem {
  id           String             @id @default(uuid())
  name         String
  edition      String
  isActive     Boolean            @default(true)
  sheetSchema  Json
  ruleFormulas Json
  campaigns    Campaign[]
  compendium   CompendiumEntry[]
}

model Campaign {
  id           String               @id @default(uuid())
  name         String
  ruleSystem   RuleSystem           @relation(fields: [ruleSystemId], references: [id])
  ruleSystemId String
  gmId         String
  createdAt    DateTime             @default(now())
  tables       Table[]
  characters   Character[]
  maps         Map[]
  memberships  CampaignMembership[]
}

model Character {
  id           String     @id @default(uuid())
  name         String
  campaign     Campaign   @relation(fields: [campaignId], references: [id])
  campaignId   String
  ownerId      String
  ruleSystemId String
  sheetData    Json
  level        Int        @default(1)
  xp           Int        @default(0)
  resources    Json
  diceRolls    DiceRoll[]
}

model CompendiumEntry {
  id           String     @id @default(uuid())
  ruleSystem   RuleSystem @relation(fields: [ruleSystemId], references: [id])
  ruleSystemId String
  type         String
  data         Json
  isHomebrew   Boolean    @default(false)
  isSRD        Boolean    @default(true)
}

model Table {
  id          String     @id @default(uuid())
  campaign    Campaign   @relation(fields: [campaignId], references: [id])
  campaignId  String
  scheduledAt DateTime?
  status      String     @default("active")
  chatLog     DiceRoll[]
}

model Map {
  id         String   @id @default(uuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  type       String
  source     String
  geoData    Json
  tokens     Json
}

model DiceRoll {
  id          String     @id @default(uuid())
  table       Table      @relation(fields: [tableId], references: [id])
  tableId     String
  character   Character? @relation(fields: [characterId], references: [id])
  characterId String?
  formula     String
  result      Json
  ruleContext String?
}
